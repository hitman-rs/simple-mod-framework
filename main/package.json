{
	"name": "mod-manager",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "cd .. && paraglide-js compile --project ./project.inlang --outdir ./main/src/lib/paraglide && cd main && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "cd .. && paraglide-js compile --project ./project.inlang --outdir ./main/src/lib/paraglide && cd main"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.18.0",
