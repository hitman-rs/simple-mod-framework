    "ProfilesDescription" : {
      "comment" : "ProfilesDesc",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can save lists of mods, with their settings, as profiles to easily switch between them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以保存带有设置的模组列表作为配置文件，以便在它们之间轻松切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
