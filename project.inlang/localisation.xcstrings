    "SDKModWarningDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mod contains ZHMModSDK mods. When you run the game, its DLLs will be able to run their own code, giving the mod's author complete control over your PC. Make sure you trust whoever developed this mod, and wherever you downloaded it from. Are you sure you want to add this mod?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模组包含 ZHMModSDK 模组。 当您运行游戏时，其 DLL 将能够运行自己的代码，让模组作者完全控制您的 PC。 请确保您信任模组开发者以及下载来源。您确定要添加这个模组吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模組包含 ZHMModSDK 模組。運行遊戲時，其 DLL 檔案將能夠執行自身程式碼，從而使模組作者能夠完全控制您的電腦。請務必確保您信任該模組的開發者及其下載來源。您確定要新增此模組嗎？"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mod contient des mods ZHMModSDK. Lorsque vous exécutez le jeu, ses DLL seront en mesure d'exécuter leur propre code, ce qui donnera à l'auteur du mod le contrôle total sur votre PC. Assurez-vous de faire confiance à ceux qui ont développé ce mod et d'où vous l'avez téléchargé. Êtes-vous sûr de vouloir ajouter ce mod ?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Mod enthält ZHMModSDK-Mods. Wenn Sie das Spiel ausführen, können deren DLLs eigenen Code ausführen. Dadurch erhält der Autor der Mod die vollständige Kontrolle über Ihren PC. Stellen Sie sicher, dass Sie den Entwicklern dieser Mod sowie der Quelle, von der Sie sie heruntergeladen haben, vertrauen. Sind Sie sicher, dass Sie diese Mod hinzufügen möchten?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod contains ZHMModSDK mods. When you run the game, its DLLs will be able to run their own code, giving the mod's author complete control over your PC. Make sure you trust whoever developed this mod, and wherever you downloaded it from. Are you sure you want to add this mod?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod contains ZHMModSDK mods. When you run the game, its DLLs will be able to run their own code, giving the mod's author complete control over your PC. Make sure you trust whoever developed this mod, and wherever you downloaded it from. Are you sure you want to add this mod?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod contains ZHMModSDK mods. When you run the game, its DLLs will be able to run their own code, giving the mod's author complete control over your PC. Make sure you trust whoever developed this mod, and wherever you downloaded it from. Are you sure you want to add this mod?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod contains ZHMModSDK mods. When you run the game, its DLLs will be able to run their own code, giving the mod's author complete control over your PC. Make sure you trust whoever developed this mod, and wherever you downloaded it from. Are you sure you want to add this mod?"
