    "UnrecognisedGameVersionNotUpdatedDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify your game files and ensure you are on the latest version of the game, using the Steam, Epic or Microsoft/Xbox app. You can search \"how do I verify my game files\" on Google for more information."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Steam、Epic 或 Microsoft/Xbox 应用程序验证您的游戏文件并确保您处于最新版本的游戏。 您可以在 Google 搜索“如何验证我的游戏文件”以获取更多信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用 Steam、Epic 或 Microsoft/Xbox 應用程式驗證遊戲文件，並確保遊戲已更新至最新版本。您可以在 Google 上搜尋「如何驗證遊戲檔案」以獲取更多資訊。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez vos fichiers de jeu et assurez-vous que vous êtes sur la dernière version du jeu, en utilisant l'application Steam, Epic ou Microsoft/Xbox. Vous pouvez rechercher \"comment puis-je vérifier mes fichiers de jeu\" sur Google pour plus d'informations."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifizieren Sie Ihre Spieldateien und stellen Sie über die Steam-, Epic- oder Microsoft/Xbox-App sicher, dass Sie die neueste Version des Spiels nutzen. Für weitere Informationen können Sie bei Google nach „Spieldateien auf Fehler überprüfen“ suchen."
