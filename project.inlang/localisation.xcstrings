          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez enregistrer des listes de mods avec leurs paramètres, dans des profils pour basculer facilement entre eux."
          }
        },
        "de" : {
          "stringUnit" : {
