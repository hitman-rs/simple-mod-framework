    "ZHMModSDKSafetyDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the SDK itself is safe for your computer, mods might not be, so SMF will warn you when you add a new mod that uses it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虽然 SDK 本身对您的计算机是安全的，但模组可能不安全。因此当您添加一个使用它的新模组时，SMF 会警告您。"
