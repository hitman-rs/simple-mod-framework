    "OnlineServicesDisabledDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analytics, and features powered by them, are currently disabled. Analytics are completely anonymous, and enabling them allows for mod conflict detection, more reliable mod update checking and other useful features."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析及其支持的特性目前已禁用。分析是完全匿名的，使其能够检测模组冲突、更可靠的模组更新检查和其他有用的功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析功能及其相關特性目前處於停用狀態。分析資料完全匿名；啟用此功能有助於偵測模組衝突、更可靠地檢查模組更新，並支援其他實用功能。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les analyses et les fonctionnalités qui les alimentent sont actuellement désactivées. Les analytiques sont complètement anonymes, et leur activation permet de détecter les conflits de mods, de vérifier les mises à jour des mods plus fiables et d'autres fonctionnalités utiles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Analyse-Funktion sowie darauf basierende Zusatzfunktionen sind derzeit deaktiviert. Die Analysen erfolgen vollständig anonym. Durch das Aktivieren ermöglichen Sie die Erkennung von Mod-Konflikten, eine zuverlässigere Updatesuche und weitere nützliche Funktionen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analytics, and features powered by them, are currently disabled. Analytics are completely anonymous, and enabling them allows for mod conflict detection, more reliable mod update checking and other useful features."
