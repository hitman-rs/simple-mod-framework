    "ZHMModSDKDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ZHMModSDK allows mods to hook into the game's behaviour while it is running, enabling new kinds of mods."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZHMModSDK 允许模组在游戏运行时绑定游戏行为，启用了新类型的模组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZHMModSDK 允許模組在遊戲運行期間掛鉤遊戲的各項行為，從而實現新型模組。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ZHMModSDK permet aux mods de s'accrocher au comportement du jeu pendant qu'il est en cours d'exécution, permettant de nouveaux types de mods."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ZHMModSDK ermöglicht es Mods, sich während der Laufzeit in das Spielverhalten einzuklinken, wodurch völlig neue Arten von Mods möglich werden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The ZHMModSDK allows mods to hook into the game's behaviour while it is running, enabling new kinds of mods."
          }
