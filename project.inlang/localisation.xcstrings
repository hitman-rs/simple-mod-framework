    "RpkgModDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模组使用了较旧的 RPKG 格式，这意味着它可能与其他模组不兼容，或者在较新的游戏版本中造成问题。它也不支持自动更新等 SMF 功能。 您确定要添加它吗？可能有较新版本的模组，或者功能相同的模组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該模組採用舊版 RPKG 格式，這意味著它可能與其他模組不相容，或在較新的遊戲版本中引發問題。此外，它也不支援自動更新等 SMF 功能。您確定要新增它嗎？也許已有該模組的更新版本，或有其他功能相同的模組可用。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mod est dans l'ancien format RPKG, ce qui signifie qu'il peut être incompatible avec d'autres mods ou causer des problèmes avec les nouvelles versions de jeu. Il ne supporte pas non plus les fonctionnalités SMF comme la mise à jour automatique. Êtes-vous sûr de vouloir l'ajouter ? Il peut y avoir une version plus récente du mod, ou un autre mod qui fait la même chose, disponible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Mod liegt im älteren RPKG-Format vor. Das bedeutet, dass sie möglicherweise inkompatibel mit anderen Mods ist oder Probleme in neueren Spielversionen verursacht. Zudem unterstützt sie keine SMF-Funktionen wie die automatische Aktualisierung. Sind Sie sicher, dass Sie sie hinzufügen möchten? Eventuell ist eine neuere Version der Mod oder eine andere Mod mit denselben Funktionen verfügbar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот мод находится в старом RPKG формате, что означает, что он может быть несовместим с другими модами или вызвать проблемы в новых версиях игры. Также не поддерживаются возможности SMF по типу автоматического обновления. Вы уверены, что хотите добавить его? Может быть доступна более новая версия мода или другой мод, который исполняет те же функции."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod is in the older RPKG format, which means that it might be incompatible with other mods, or cause issues in newer game versions. It also won't support SMF features like automatic updating. Are you sure you want to add it? There may be a newer version of the mod, or another mod that does the same thing, available."
