    "PeacockPluginWarningDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mod contains Peacock plugins; if you use the Peacock server emulator after applying this mod, its plugins will be able to run their own code, giving the mod's author complete control over your PC. Make sure you trust whoever developed this mod, and wherever you downloaded it from. Are you sure you want to add this mod?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模组包含 Peacock 插件；如果您在应用此模组后使用了 Peacock 模拟服务器，它的插件将能够运行自己的代码，让模组的作者完全控制您的 PC。请确保您信任此模组的开发者以及下载来源。您确定要添加这个模组吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
