    "EnableOnlineServicesDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This feature enables completely anonymous reporting of mod lists and basic settings, which allows for statistics around mod usage and conflict detection. It also makes mod update checking more reliable, avoiding rate-limiting for mods hosted on GitHub. A ping with no other information will still be sent if this is disabled, to allow determining how representative the sample is."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能允许完全匿名报告模组列表和基本设置，允许提供关于模组使用和冲突侦测的统计数据。它还使模组更新检查更加可靠，避免对托管在 GitHub 上的模组进行比率限制。如果禁用，将仍然发送没有其他信息的ping，以确定样品的代表性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能支援完全匿名上報模組列表及基本設置，從而能夠統計模組使用情況並檢測衝突。此外，它還提高了模組更新檢查的可靠性，避免了因頻繁請求而觸發 GitHub 的速率限制。即使停用了此功能，系統仍會發送僅包含基本連通性的不含其他資訊的訊號的請求，以便評估樣本的代表性。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fonctionnalité permet des rapports totalement anonymes des listes de mods et des paramètres de base, ce qui permet des statistiques sur l'utilisation des mods et la détection des conflits. Il rend également la vérification des mises à jour des mods plus fiables, évitant ainsi la limitation des tarifs pour les mods hébergés sur GitHub. Un ping sans autre information sera toujours envoyé si cette option est désactivée, pour permettre de déterminer la représentativité de l'échantillon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Funktion ermöglicht die vollständig anonyme Übermittlung von Mod-Listen und grundlegenden Einstellungen. Dies erlaubt Statistiken zur Mod-Nutzung sowie die Erkennung von Konflikten. Zudem wird dadurch die Updatesuche zuverlässiger, da ein Rate-Limiting für Mods auf GitHub vermieden wird. Auch bei Deaktivierung wird ein Ping ohne weitere Informationen gesendet, um festzustellen, wie repräsentativ die Stichprobe ist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This feature enables completely anonymous reporting of mod lists and basic settings, which allows for statistics around mod usage and conflict detection. It also makes mod update checking more reliable, avoiding rate-limiting for mods hosted on GitHub. A ping with no other information will still be sent if this is disabled, to allow determining how representative the sample is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This feature enables completely anonymous reporting of mod lists and basic settings, which allows for statistics around mod usage and conflict detection. It also makes mod update checking more reliable, avoiding rate-limiting for mods hosted on GitHub. A ping with no other information will still be sent if this is disabled, to allow determining how representative the sample is."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This feature enables completely anonymous reporting of mod lists and basic settings, which allows for statistics around mod usage and conflict detection. It also makes mod update checking more reliable, avoiding rate-limiting for mods hosted on GitHub. A ping with no other information will still be sent if this is disabled, to allow determining how representative the sample is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This feature enables completely anonymous reporting of mod lists and basic settings, which allows for statistics around mod usage and conflict detection. It also makes mod update checking more reliable, avoiding rate-limiting for mods hosted on GitHub. A ping with no other information will still be sent if this is disabled, to allow determining how representative the sample is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This feature enables completely anonymous reporting of mod lists and basic settings, which allows for statistics around mod usage and conflict detection. It also makes mod update checking more reliable, avoiding rate-limiting for mods hosted on GitHub. A ping with no other information will still be sent if this is disabled, to allow determining how representative the sample is."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта функция включает полностью анонимные отчеты о списках модов и базовых настройках, что позволяет собирать статистику по использованию модов и обнаружению конфликтов. Это также делает проверку обновлений модов более надежной, избегая ограничения скорости для модов, размещенных на GitHub. Если эта опция отключена, то запрос с другой информацией все равно будет отправлен, чтобы разрешить определить, насколько репрезентативна выборка."
          }
        },
        "es" : {
