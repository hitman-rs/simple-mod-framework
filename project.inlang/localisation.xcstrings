    "ModUpdateRateLimitDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{skipped} mods couldn't be checked for updates due to Nexus Mods or GitHub rate limiting. Consider enabling analytics and server features to avoid this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于 Nexus Mods 或 GitHub 速率限制，{skipped} 模组无法检查更新。请考虑启用分析和服务器特性以避免。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法檢查 {skipped} 模組的更新，原因是受到了 Nexus Mods 或 GitHub 的速率限制。建議啟用分析與伺服器功能以避免此問題。"
          }
