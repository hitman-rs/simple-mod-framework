    "ZHMModSDKSafetyDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the SDK itself is safe for your computer, mods might not be, so SMF will warn you when you add a new mod that uses it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虽然 SDK 本身对您的计算机是安全的，但模组可能不安全。因此当您添加一个使用它的新模组时，SMF 会警告您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儘管 SDK 本身對你的電腦是安全的，但模組未必如此；因此，當新增使用該 SDK 的新模組時，SMF 會向你發出提示。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien que le SDK lui-même soit sûr pour votre ordinateur, les mods peuvent ne pas être, SMF peut vous avertir lorsque vous ajoutez un nouveau mod qui l'utilise."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während das SDK selbst für Ihren Computer sicher ist, gilt dies für Mods nicht zwingend. Daher warnt das SMF Sie, wenn Sie eine neue Mod hinzufügen, die dieses nutzt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "While the SDK itself is safe for your computer, mods might not be, so SMF will warn you when you add a new mod that uses it."
