    "UnrecognisedGameVersionUpdatedDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for the Simple Mod Framework to be updated by its developers. You will see the update when it is released on the Home page. Do not post a comment on Nexus about this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待开发者更新 Simple Mod Framework。发布后您将在主页看到更新。请不要在 Nexus 上发表此问题的评论。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請等待 Simple Mod Framework 的開發者發布更新。一旦更新在主頁發布，您就能看到。請勿就此事在 Nexus 上發表評論。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez que le Simple Mod Framework soit mis à jour par ses développeurs. Vous verrez la mise à jour quand elle sera publiée sur la page d'accueil. Ne publiez pas de commentaire sur Nexus à ce sujet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten Sie, bis das Simple-Mod-Framework von seinen Entwicklern aktualisiert wird. Sie werden das Update sehen, sobald es auf der Startseite veröffentlicht wird. Bitte hinterlassen Sie dazu keinen Kommentar auf Nexus."
          }
        },
