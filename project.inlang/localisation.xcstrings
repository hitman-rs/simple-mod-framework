        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This mod contains ZHMModSDK mods. When you run the game, its DLLs will be able to run their own code, giving the mod's author complete control over your PC. Make sure you trust whoever developed this mod, and wherever you downloaded it from. Are you sure you want to add this mod?"
          }
