    "CustomBootSceneDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overrides the scene path that the game launches to. Should be a bare scene path, without the .pc_entitytype suffix."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖游戏启动到的场景路径。应该是裸场景路径，而不是 .pc_entityype 后缀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆蓋遊戲啟動時載入的場景路徑。應為不含 `.pc_entitytype` 字尾的純場景路徑。"
          }
        },
        "fr" : {
          "stringUnit" : {
