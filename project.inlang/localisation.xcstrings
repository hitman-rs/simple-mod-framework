    "ImproperInstalledModDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One or more mods have been installed directly into the Mods folder. This is not recommended; the GUI performs checks on mods for validity and security and installing directly to the Mods folder bypasses this. It's easy to break the framework by doing this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个或多个模组已直接安装到模组文件夹中。不推荐这样做：GUI可检查模组的有效性和安全性，直接安装到模组文件夹会绕过此功能。这样做很容易破坏框架。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一個或多個模組直接安裝到了 Mods 資料夾中。這種做法不被推薦；圖形介面會對模組進行有效性和安全性檢查，而直接安裝到 Mods 資料夾會繞過這些檢查，這很容易導致框架損壞。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ou plusieurs mods ont été installés directement dans le dossier Mods. Ce n'est pas recommandé ; l'interface graphique vérifie la validité et la sécurité des mods et les installer directement dans le dossier Mods contourne les vérifications. Il est facile de briser SMF en faisant cela."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein oder mehrere Mods wurden direkt im Mods-Ordner installiert. Dies wird nicht empfohlen. Die GUI überprüft Mods auf Gültigkeit und Sicherheit — eine direkte Installation im Mods-Ordner umgeht diese Prüfungen. Dadurch kann das Framework leicht beschädigt werden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "One or more mods have been installed directly into the Mods folder. This is not recommended; the GUI performs checks on mods for validity and security and installing directly to the Mods folder bypasses this. It's easy to break the framework by doing this."
          }
        },
        "ja" : {
