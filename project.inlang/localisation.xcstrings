    "CreditsText" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Simple Mod Framework directly uses the rpkg-rs library by Dafitius and the ResourceLib library by OrfeasZ for much of its functionality. The framework itself is licensed LGPLv3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple Mod Manager 直接使用 Dafitius 的 rpkg-rs 库和 OrfeasZ 的 ResourceLib 库进行其大部分功能。 框架本身采用 LGPLv3 许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple Mod Framework 的許多功能直接使用了 Dafitius 開發的 rpkg-rs 函式庫和 OrfeasZ 開發的 ResourceLib 函式庫。該框架本身採用 LGPLv3 授權。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
