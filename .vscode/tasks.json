{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build:debug",
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "ui:dev",
			"type": "shell",
			"isBackground": true,
			"command": "yarn",
			"options": {
				"cwd": "${workspaceFolder}/main"
			},
			"args": [
				"dev"
			],
			"problemMatcher": [
				{
					"pattern": [
						{
							"regexp": ".",
							"file": 1,
							"location": 2,
							"message": 3
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".*ready in.*",
						"endsPattern": ".",
					}
				}
			]
		},
		{
			"label": "dev",
			"dependsOn": [
				"build:debug",
				"ui:dev"
			],
			"group": {
				"kind": "build"
			}
		}
	]
}